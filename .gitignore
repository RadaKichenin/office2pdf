/target
target*/
*.pdf
!tests/golden_mocks/business/expected/**/*.pdf

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude local settings and memory (machine-specific, not shared)
.claude/settings.local.json
.claude/memory/

# Classified fixtures (confidential, never upload)
tests/classified_fixtures/

# Docs (local-only analysis/notes, never push to remote)
docs/

# Ralph (local-only automation, never push to remote)
scripts/ralph/
.DS_Store
__pycache__/
*.py[cod]

# Bulk third-party fixture corpus, fetched from the fixtures-v1 release rather than
# committed. Git LFS bandwidth is billed to this repository's owner for every clone and
# fork, including forks we do not control; release asset downloads are not metered.
# The 187-file subset the default test suite reads is tracked normally and is unaffected
# by these patterns, because .gitignore does not apply to already-tracked files.
tests/fixtures/*/libreoffice/*
tests/fixtures/*/poi/*
